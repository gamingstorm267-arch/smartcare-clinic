<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>SmartCare Clinic</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background: #f4f8fb;
        }

        header {
            background: #0a6ebd;
            color: white;
            padding: 20px;
            text-align: center;
        }

        nav {
            display: flex;
            justify-content: center;
            gap: 20px;
            background: #084c86;
            padding: 10px;
        }

        nav a {
            color: white;
            text-decoration: none;
        }

        .hero {
            padding: 50px;
            text-align: center;
            background: linear-gradient(to right, #0a6ebd, #4bb3fd);
            color: white;
        }

        .section {
            padding: 40px;
            text-align: center;
        }

        .card {
            background: white;
            padding: 20px;
            margin: 10px;
            display: inline-block;
            width: 250px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        /* Chatbot */
        #chatbot {
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 300px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
            display: flex;
            flex-direction: column;
        }

        #chat-header {
            background: #0a6ebd;
            color: white;
            padding: 10px;
            border-radius: 10px 10px 0 0;
        }

        #chat-messages {
            height: 250px;
            overflow-y: auto;
            padding: 10px;
        }

        .message {
            margin: 5px 0;
        }

        .user {
            text-align: right;
        }

        .bot {
            text-align: left;
            color: #0a6ebd;
        }

        #chat-input {
            display: flex;
        }

        #chat-input input {
            flex: 1;
            padding: 10px;
            border: none;
        }

        #chat-input button {
            background: #0a6ebd;
            color: white;
            border: none;
            padding: 10px;
        }
    </style>
</head>

<body>

    <header>
        <h1>SmartCare Medical Clinic</h1>
        <p>Your Health, Our Priority</p>
    </header>

    <nav>
        <a href="#">Home</a>
        <a href="#">Services</a>
        <a href="#">Doctors</a>
        <a href="#">Appointments</a>
        <a href="#">Contact</a>
    </nav>

    <div class="hero">
        <h2>AI-Powered Healthcare</h2>
        <p>Book appointments, chat with AI, and manage your health online</p>
    </div>

    <div class="section">
        <h2>Our Services</h2>

        <div class="card">General Checkup</div>
        <div class="card">Pediatrics</div>
        <div class="card">Cardiology</div>
        <div class="card">Diagnostics</div>

    </div>

    <div class="section">
        <h2>Book Appointment</h2>
        <input type="text" placeholder="Your Name"><br><br>
        <input type="date"><br><br>
        <button onclick="alert('Appointment Requested!')">Book Now</button>
    </div>

    <!-- AI Chatbot -->
    <div id="chatbot">
        <div id="chat-header">AI Assistant</div>

        <div id="chat-messages"></div>

        <div id="chat-input">
            <input type="text" id="userInput" placeholder="Ask me anything...">
            <button onclick="sendMessage()">Send</button>
        </div>
    </div>

    <script>
        function addMessage(text, sender) {
            const msgDiv = document.createElement("div");
            msgDiv.className = "message " + sender;
            msgDiv.innerText = text;
            document.getElementById("chat-messages").appendChild(msgDiv);
        }

        function sendMessage() {
            const input = document.getElementById("userInput");
            const text = input.value;

            if (!text) return;

            addMessage(text, "user");

            // Simple AI logic (replace with API later)
            let reply = "I'm here to help!";

            if (text.toLowerCase().includes("appointment")) {
                reply = "You can book appointments using the form above.";
            } else if (text.toLowerCase().includes("timing")) {
                reply = "Clinic is open from 9 AM to 8 PM.";
            } else if (text.toLowerCase().includes("doctor")) {
                reply = "We have expert specialists available daily.";
            }

            setTimeout(() => addMessage(reply, "bot"), 500);

            input.value = "";
        }
    </script>

</body>

</html>